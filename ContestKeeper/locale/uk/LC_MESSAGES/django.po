msgstr "Розвивайте свою подорож програмування."

msgid ""
"Join a community of top developers, compete in high-stakes tournaments, and "
"showcase your skills to the world."
msgstr ""
"Приєднуйтеся до спільноти найкращих розробників, змагайтеся в турнірах із "
"високими ставками та демонструйте свої навички світові."

msgid "Create Account"
msgstr "Створити акаунт"

msgid "Please correct the details below to continue."
msgstr "Будь ласка, виправте деталі нижче, щоб продовжити."

msgid "e.g. coder_pro"
msgstr "напр. coder_pro"

msgid "Email Address"
msgstr "Адреса електронної пошти"

msgid "you@example.com"
msgstr "you@example.com"

msgid "John"
msgstr "Іван"

msgid "Doe"
msgstr "Мазепа"

msgid "••••••••"
msgstr ""

msgid "Repeat Password"
msgstr "Повторіть пароль"

msgid "Register Now"
msgstr "Зареєструватися зараз"

msgid "Already have an account?"
msgstr "Вже маєте акаунт?"

msgid "Log in here"
msgstr "Увійдіть тут"

#, python-format
msgid "Schedule regenerated from %(count)s round events."
msgstr "Розклад регенеровано з %(count)s подій раундів."

#, python-format
msgid "New announcement: %(title)s"
msgstr "Нове оголошення: %(title)s"

msgid "Announcement published successfully."
msgstr "Оголошення успішно опубліковано."

#, python-format
msgid ""
"Cannot approve: Contest '%(name)s' has reached its maximum of %(max)s teams."
msgstr "Не вдалося схвалити: Конкурс '%(name)s' досяг ліміту в %(max)s команд."

msgid "approved"
msgstr "схвалено"

msgid "rejected"
msgstr "відхилено"

#, python-format
msgid "Application %(status)s"
msgstr "Заявка %(status)s"

#, python-format
msgid "Your application for '%(name)s' has been %(status)s."
msgstr "Ваша заявка на '%(name)s' була %(status)s."

msgid "Cannot apply to a draft contest."
msgstr "Неможливо подати заявку на чернетку конкурсу."

msgid "Individual registration is disabled. Please create or join a team."
msgstr ""
"Індивідуальна реєстрація вимкнена. Будь ласка, створіть команду або "
"приєднайтеся до існуючої."

msgid "This contest has already finished."
msgstr "Цей конкурс уже завершився."

msgid "Invalid application type."
msgstr "Некоректний тип заявки."

msgid "Registration for this contest has not started yet."
msgstr "Реєстрація на цей конкурс ще не розпочалася."

msgid "Registration for this contest has already closed."
msgstr "Реєстрація на цей конкурс уже закрита."

msgid "You are not the organizer of this contest."
msgstr "Ви не є організатором цього конкурсу."

msgid "You are not a Jury member for this contest."
msgstr "Ви не є членом журі цього конкурсу."

msgid "You do not have access to this page."
msgstr "У вас немає доступу до цієї сторінки."

msgid "Contest is in draft or you don't have access."
msgstr "Конкурс знаходиться в статусі чернетки або у вас немає доступу."

#, python-format
msgid "Successfully created %(num)s jury assignments for %(count)s teams."
msgstr "Успішно створено %(num)s призначень журі для %(count)s команд."

msgid "You are not assigned to evaluate this team."
msgstr "Ви не призначені для оцінювання цієї команди."

msgid "Evaluation is already finalized and cannot be edited."
msgstr "Оцінювання вже завершено і не може бути відредаговано."

#, python-format
msgid "Scores for %(name)s have been saved."
msgstr "Бали для %(name)s були збережені."

msgid "Leaderboard is not yet available. Evaluation is still in progress."
msgstr "Таблиця лідерів ще не доступна. Оцінювання триває."

msgid "Jury breakdown is not available for participants at this time."
msgstr "Розшифровка оцінок журі наразі недоступна для учасників."

msgid "Create Scoring Criterion"
msgstr "Створити критерій оцінювання"

#, python-format
msgid "Edit Criterion: %(name)s"
msgstr "Редагувати критерій: %(name)s"

#, python-format
msgid "Scoring Criterion: %(name)s"
msgstr "Критерій оцінювання: %(name)s"

msgid "Deadline must be after start time."
msgstr "Дедлайн має бути після часу початку."

msgid "Deadline cannot be in the past."
msgstr "Дедлайн не може бути в минулому."

msgid "Must have at least one checklist item."
msgstr "Має бути принаймні один пункт у контрольному списку."

msgid "Cannot edit a round that is not in DRAFT status."
msgstr "Неможливо редагувати раунд, який не перебуває в статусі ЧЕРНЕТКА."

msgid "Invalid must_have format."
msgstr "Некоректний формат обов'язкових пунктів."

#, python-format
msgid "Can only activate DRAFT rounds. Current status: %(status)s"
msgstr ""
"Можна активувати лише раунди в статусі ЧЕРНЕТКА. Поточний статус: %(status)s"

#, python-format
msgid "Round started: %(title)s"
msgstr "Раунд розпочато: %(title)s"

#, python-format
msgid ""
"New round '%(title)s' is now active in '%(contest)s'. Deadline: %(deadline)s"
msgstr ""
"Новий раунд '%(title)s' тепер активний у '%(contest)s'. Дедлайн: %(deadline)s"

msgid "Can only close submissions for ACTIVE rounds."
msgstr "Закрити подання можна лише для АКТИВНИХ раундів."

#, python-format
msgid "Submissions closed: %(title)s"
msgstr "Подання закрито: %(title)s"

#, python-format
msgid "Submissions for round '%(title)s' in '%(contest)s' are now closed."
msgstr "Подання для раунду '%(title)s' у '%(contest)s' тепер закриті."

#, python-format
msgid ""
"Submissions for round '%(title)s' in '%(contest)s' are closed. You can now "
"start evaluations."
msgstr ""
"Подання для раунду '%(title)s' у '%(contest)s' закриті. Тепер ви можете "
"розпочати оцінювання."

msgid "Can only extend deadline for ACTIVE rounds."
msgstr "Продовжити дедлайн можна лише для АКТИВНИХ раундів."

msgid "New deadline is required."
msgstr "Необхідно вказати новий дедлайн."

msgid "Invalid datetime format."
msgstr "Некоректний формат дати та часу."

msgid "New deadline cannot be in the past."
msgstr "Новий дедлайн не може бути в минулому."

msgid "This round is not available yet."
msgstr "Цей раунд ще не доступний."

msgid "You do not have access to this contest."
msgstr "У вас немає доступу до цього конкурсу."

msgid "You are not part of any team in this contest."
msgstr "Ви не перебуваєте в жодній команді цього конкурсу."

msgid "This round is not currently open for submissions."
msgstr "Цей раунд наразі не відкритий для подання робіт."

msgid "Your submission has been saved successfully."
msgstr "Ваше подання успішно збережено."

msgid "You do not have access to this submission."
msgstr "У вас немає доступу до цього подання."

msgid "Only assigned jurors can submit scores."
msgstr "Тільки призначені судді можуть подавати бали."

msgid "Evaluation is already finalized."
msgstr "Оцінювання вже завершено."

msgid "Score is required."
msgstr "Оцінка обов'язкова."

msgid ""
"This contest has multiple scoring criteria. Please use the full evaluation "
"form."
msgstr ""
"Цей конкурс має кілька критеріїв оцінювання. Будь ласка, використовуйте "
"повну форму оцінювання."

msgid "No scoring criteria defined for this contest."
msgstr "Для цього конкурсу не визначено критеріїв оцінювання."

#, python-format
msgid "Score for %(name)s updated successfully."
msgstr "Бал для %(name)s успішно оновлено."

#, python-format
msgid "Error saving score: %(error)s"
msgstr "Помилка збереження бала: %(error)s"

msgid "You are not the captain of this team."
msgstr "Ви не капітан цієї команди."

msgid "Only the organizer can perform this action."
msgstr "Цю дію може виконати лише організатор."

msgid "Only the organizer or team captain can delete this team."
msgstr "Видалити цю команду може лише організатор або капітан команди."

msgid "Team deleted successfully."
msgstr "Команду успішно видалено."

#, python-format
msgid "Jury member '%(username)s' removed from the contest."
msgstr "Члена журі '%(username)s' видалено з конкурсу."

msgid "You do not have admin access to this contest."
msgstr "У вас немає адміністративного доступу до цього конкурсу."

msgid "You are not authorized to edit this team."
msgstr "Ви не авторизовані для редагування цієї команди."

msgid "Registration for this contest has closed."
msgstr "Реєстрація на цей конкурс закрита."

msgid "You are already a member of a team in this contest."
msgstr "Ви вже є членом команди в цьому конкурсі."

msgid "You already have a team application for this contest."
msgstr "У вас уже є заявка на участь команди в цьому конкурсі."

#, python-format
msgid "Team '%(name)s' created! Approval from organizer is pending."
msgstr "Команду '%(name)s' створено! Очікується схвалення організатором."

msgid "You are blocked from joining this team."
msgstr "Вам заборонено приєднуватися до цієї команди."

msgid "You are already in a team for this contest."
msgstr "Ви вже перебуваєте в команді для цього конкурсу."

msgid "You have already applied to this team."
msgstr "Ви вже подали заявку до цієї команди."

#, python-format
msgid "Application to join '%(name)s' submitted!"
msgstr "Заявку на приєднання до '%(name)s' подано!"

msgid ""
"You already have a pending application for another team in this contest."
msgstr "У вас уже є незавершена заявка для іншої команди в цьому конкурсі."

msgid "Team captain cannot leave the team."
msgstr "Капітан команди не може залишити команду."

msgid "You are not a member of this team."
msgstr "Ви не є членом цієї команди."

msgid "You have left the team."
msgstr "Ви залишили команду."

